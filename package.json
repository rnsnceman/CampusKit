{
  "name": "campuskit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "COMP229 Part 1 - Campus equipment lending application",
  "scripts": {
    "dev": "node server/scripts/dev.js",
    "server": "node --watch server/index.js",
    "client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "seed": "node server/scripts/seed.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "demo": "node server/scripts/dev.js --demo"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "mongodb-memory-server": "^10.3.0",
    "supertest": "^7.1.4",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
