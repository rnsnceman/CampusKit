{
  "info": {
    "name": "CampusKit Part 1 - ordered API demonstration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order on a local test database. Creates and removes its own disposable student, asset, and requests. Configure the admin password first. Does not delete seeded sample equipment."
  },
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Register disposable student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Student\",\n  \"email\": \"campuskit{{$timestamp}}@example.test\",\n  \"password\": \"{{studentPassword}}\",\n  \"role\": \"admin\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const d=pm.response.json(); pm.environment.set('studentToken',d.token); pm.environment.set('studentId',d.user._id); pm.environment.set('studentEmail',d.user.email); pm.test('No role escalation',()=>pm.expect(d.user.role).to.eql('student'));"
            ]
          }
        }
      ]
    },
